# Copy to .env and change the passwords. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-mongo

REDIS_PASSWORD=change-me-redis

# Connection URLs for the exercise scripts. Use the same passwords as above, and change
# the database name (or the Redis database number) to the one each exercise gives.
# Load them with: uv run --env-file <path to this .env> python script.py
# (from an exercise folder such as exercises/04-crud/exercise/ the path is ../../../.env)
# SQLAlchemy needs the driver in the scheme: postgresql+psycopg://...
DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/pagila
READONLY_DATABASE_URL=postgresql://readonly:change-me-readonly@localhost:5432/pagila
MONGO_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
REDIS_URL=redis://:change-me-redis@localhost:6379/0

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
SOFTWARE_VERSION_TAG=latest