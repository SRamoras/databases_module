# Copiar para .env e mudar as palavras-passe. Nunca fazer commit do .env.
# As palavras-passe de administração têm de ser as do .env da raiz do repositório.

# PostgreSQL: palavras-passe dos três roles criados por roles.sql (são passadas ao psql com -v).
EX09_MIGRATIONS_PASSWORD=change-me-ex09-migrations
EX09_APP_PASSWORD=change-me-ex09-app
EX09_READONLY_PASSWORD=change-me-ex09-readonly
# O que a API usa: só o role ex09_app.
DATABASE_URL=postgresql://ex09_app:change-me-ex09-app@localhost:5432/ex09

# MongoDB root: usado só por scripts/setup_mongo.py para criar o utilizador da API.
MONGO_ADMIN_URL=mongodb://root:change-me-mongo@localhost:27017/?authSource=admin
MONGO_DB=ex09
MONGO_APP_PASSWORD=change-me-ex09-mongo-app
# O que a API usa: o utilizador ex09_app, com readWrite só em ex09.
MONGO_URL=mongodb://ex09_app:change-me-ex09-mongo-app@localhost:27017/ex09?authSource=ex09

# Redis utilizador default: usado só por scripts/setup_redis.py para criar o utilizador ACL.
REDIS_ADMIN_URL=redis://:change-me-redis@localhost:6379/0
REDIS_APP_PASSWORD=change-me-ex09-redis-app
# O que a API usa: o utilizador ACL ex09_app, que só pode fazer INCR em counter:*.
REDIS_URL=redis://ex09_app:change-me-ex09-redis-app@localhost:6379/0
